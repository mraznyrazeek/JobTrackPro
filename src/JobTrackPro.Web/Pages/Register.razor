@page "/register"
@using JobTrackPro.Application.DTOs.Auth
@inject JobTrackPro.Web.Services.AuthService AuthService

<h3>Register</h3>

<input @bind="model.FullName" placeholder="Full Name" />
<br />
<input @bind="model.Email" placeholder="Email" />
<br />
<input type="password" @bind="model.Password" placeholder="Password" />
<br />
<button @onclick="RegisterUser">Register</button>

<p>@message</p>

@code {
    private RegisterRequestDto model = new();
    private string message = "";

    private async Task RegisterUser()
    {
        var result = await AuthService.Register(model);
        message = result?.Message ?? "Error";
    }
}